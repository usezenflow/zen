{
  "expo": {
    "name": "Zen",
    "slug": "zen",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zen",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.alpha.zen",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbfaf7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "package": "com.alpha.zen"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbfaf7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#121314",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.alpha.zen",
            "activationRule": { "supportsText": true, "supportsWebUrlWithMaxCount": 1, "supportsImageWithMaxCount": 1, "supportsFileWithMaxCount": 1 }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/*", "image/*", "application/pdf"],
            "multipleShareMimeTypes": []
          }
        }
      ],
      "expo-background-task",
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 26 } }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "zen dùng micro để bạn nói lịch của mình.",
          "speechRecognitionPermission": "zen chuyển lời bạn nói thành chữ để xếp lịch. Khi máy có sẵn tiếng Việt, việc này diễn ra ngay trên máy.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/zenflow_default.wav",
            "./assets/sounds/zenflow_reminder.wav",
            "./assets/sounds/zenflow_urgent.wav"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BeVietnamPro-Light.ttf",
            "./assets/fonts/BeVietnamPro-Regular.ttf",
            "./assets/fonts/BeVietnamPro-Medium.ttf",
            "./assets/fonts/BeVietnamPro-SemiBold.ttf",
            "./assets/fonts/BeVietnamPro-Bold.ttf",
            "./assets/fonts/BeVietnamPro-ExtraBold.ttf"
          ]
        }
      ],
      "./plugins/with-widget-fonts",
      "./plugins/with-lms-ca",
      "./plugins/with-release-signing",
      "./plugins/with-proguard-rules",
      "./plugins/with-app-label",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.alpha.zen",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "ZenNext",
              "displayName": "Tiếp theo",
              "description": "Việc tiếp theo và thời gian còn lại",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ZenNext.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "src/widgets/ZenNext.android.tsx"
              }
            },
            {
              "name": "ZenTalk",
              "displayName": "Nói",
              "description": "Mở zen và nghe ngay",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ZenTalk.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "src/widgets/ZenTalk.android.tsx"
              }
            },
            {
              "name": "ZenScan",
              "displayName": "Chụp",
              "description": "Mở zen với camera, chụp thông báo hay lịch thi",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ZenScan.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "src/widgets/ZenScan.android.tsx"
              }
            },
            {
              "name": "ZenExam",
              "displayName": "Sắp thi",
              "description": "Đếm ngày đến kỳ thi gần nhất",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ZenExam.ios.tsx"
              },
              "android": {
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110,
                "resizeMode": "none",
                "initialLayout": "src/widgets/ZenExam.android.tsx"
              }
            },
            {
              "name": "ZenToday",
              "displayName": "Hôm nay",
              "description": "Việc hôm nay, đánh dấu xong ngay trên màn hình chính",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ZenToday.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "minWidth": 250,
                "minHeight": 110,
                "resizeMode": "vertical",
                "initialLayout": "src/widgets/ZenToday.android.tsx"
              }
            },
            {
              "name": "ZenLock",
              "displayName": "zen",
              "description": "Việc tiếp theo trên màn hình khoá",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "src/widgets/ZenLock.ios.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "zen đọc ảnh bạn chọn để tìm lịch thi, hạn nộp trong đó.",
          "cameraPermission": "zen dùng camera để đọc thông báo, lịch thi bạn chụp.",
          "microphonePermission": "zen dùng micro để bạn nói lịch của mình."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
