+
+  // zen patch: props may carry a timeline `tl` of { at, p } (epoch ms). The layout shows the entry due now; this asks the system to
+  // redraw at the next entry, so the widget rolls on its own clock as iOS timelines do. Inexact and non-waking: it lands once the screen is on.
+  private fun scheduleNext(context: Context, props: Map<String, Any?>?) {
+    val now = System.currentTimeMillis()
+    val next = (props?.get("tl") as? List<*>)
+      ?.mapNotNull { ((it as? Map<*, *>)?.get("at") as? Number)?.toLong() }
+      ?.filter { it > now }
+      ?.minOrNull() ?: return
+    val component = widgetProviderComponentName(context, widgetName)
+    val ids = AppWidgetManager.getInstance(context).getAppWidgetIds(component)
+    if (ids.isEmpty()) return
+    val intent = Intent(AppWidgetManager.ACTION_APPWIDGET_UPDATE)
+      .setComponent(component)
+      .putExtra(AppWidgetManager.EXTRA_APPWIDGET_IDS, ids)
+    val pending = PendingIntent.getBroadcast(context, widgetName.hashCode(), intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE)
+    (context.getSystemService(Context.ALARM_SERVICE) as AlarmManager).set(AlarmManager.RTC, next, pending)
+  }
 }
